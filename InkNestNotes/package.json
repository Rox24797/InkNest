{
  "name": "inknest-notes",
  "productName": "InkNest Notes",
  "version": "1.0.0",
  "description": "InkNest Notes - a handwriting-first study notebook for your PC",
  "author": "InkNest Studio",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.inknest.notes",
    "productName": "InkNest Notes",
    "copyright": "Copyright © 2026 InkNest Studio",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**/*", "build/icon.png", "package.json"],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InkNest Notes",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  }
}
